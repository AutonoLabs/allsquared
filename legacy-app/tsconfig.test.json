{
  "extends": "./tsconfig.json",
  "include": [
    "client/src/**/*",
    "shared/**/*",
    "server/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "build", "dist"],
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals"]
  }
}
