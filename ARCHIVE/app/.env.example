# AllSquared — Environment Variables
# Copy to .env and fill in values

# PostgreSQL connection (Neon recommended for Vercel)
DATABASE_URL=postgresql://user:password@host:5432/allsquared

# Clerk authentication
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# JWT for internal session signing (required in production)
JWT_SECRET=

# Stripe payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OpenAI — contract generation & Squario chatbot (server-side only)
OPENAI_API_KEY=sk-...

# DocuSeal — self-hosted e-signature (recommended)
DOCUSEAL_API_KEY=
DOCUSEAL_URL=https://sign.allsquared.io

# App URL — used for Stripe/DocuSeal/escrow redirect callbacks
APP_URL=https://allsquared.io

# Cloudflare R2 — contract file attachments
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET=
CLOUDFLARE_R2_BUCKET=allsquared-files

# Companies House — UK company lookup
COMPANIES_HOUSE_API_KEY=

# LexAI — local legal RAG engine (optional)
LEXAI_API_URL=http://localhost:8400

# Admin bootstrap — comma/space separated emails become admin on sign-in/up
ADMIN_EMAILS=eli@bernstein.com.au

# Sanity CMS — public blog content (optional)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2025-01-01

# Sentry — error tracking (leave blank to disable)
SENTRY_DSN=
VITE_SENTRY_DSN=

# Upstash Redis — distributed rate limiting (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Transpact — UK FCA-authorised escrow (optional)
TRANSPACT_WEBHOOK_SECRET=
TRANSPACT_API_KEY=
