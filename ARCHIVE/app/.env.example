# AllSquared — Environment Variables
# Copy to .env and fill in values

# PostgreSQL connection (Neon, Supabase, or local)
DATABASE_URL=postgresql://user:password@host:5432/allsquared

# Clerk authentication
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Stripe payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OpenAI — contract generation & chatbot
OPENAI_API_KEY=sk-...

# Companies House — UK company lookup
COMPANIES_HOUSE_API_KEY=

# LexAI — local legal RAG engine (defaults to http://localhost:8400)
LEXAI_API_URL=http://localhost:8400

# Admin bootstrap — comma/space separated emails become admin on sign-in/up
ADMIN_EMAILS=eli@bernstein.com.au

# Sanity CMS — public blog content
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2025-01-01

# Sentry — error tracking (leave blank to disable)
SENTRY_DSN=
VITE_SENTRY_DSN=

# Upstash Redis — distributed rate limiting (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Transpact — UK FCA-authorised escrow (secondary provider)
TRANSPACT_WEBHOOK_SECRET=
TRANSPACT_API_KEY=
